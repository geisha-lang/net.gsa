// Verification suite for `net.gsa` (`tests/spec.gsa`).

use std.option.{Some, None}
use std.result.{Result, Ok, Err}
use std.str.intToStr
use std.task.{spawn, await}
use sys.net.{tcpListen, tcpLocalPort, tcpAccept, tcpCloseListener}
use sys.io.eprintLn
use sys.proc.exit

use net.ws.{WsText, wsAccept, wsConnect, wsSendText, wsSendTextMasked, wsRecv, wsClose}
use net.http.{HttpHeader, httpsGet, httpHeaderGet, urlEncode, decodeChunkedBody}

def assertTrue(label: String, ok: Bool): Result Void String =
    if (ok) Ok(()) else Err("ASSERT FAILED: " + label)

def testLoopbackWs(): Result Void String = {
    let listener = tcpListen("127.0.0.1", 0)?;
    let port = tcpLocalPort(listener);

    let srv = spawn(() -> {
        let client = tcpAccept(listener)?;
        let ws = wsAccept(client)?;
        match wsRecv(ws) {
            Ok(WsText(msg)) -> {
                let _ = wsSendText(ws, "echo:" + msg)?;
                wsClose(ws);
                Ok(())
            },
            _ -> { wsClose(ws); Err("unexpected ws frame") },
        }
    });

    let c = wsConnect("127.0.0.1", port, "/chat")?;
    wsSendTextMasked(c, "hello-net-gsa")?;
    let reply = wsRecv(c)?;
    wsClose(c);
    let _ = await(srv)?;
    tcpCloseListener(listener);

    match reply {
        WsText(s) -> assertTrue("WS loopback echo", s == "echo:hello-net-gsa")?,
        _ -> assertTrue("expected WsText", false)?,
    };
    printLn("  [PASS] net.ws: concurrent RFC 6455 loopback server + client over ByteStream");
    Ok(())
}

def testHttpHelpers(): Result Void String = {
    assertTrue("urlEncode basic", urlEncode("BTC/USDT 100%") == "BTC%2FUSDT%20100%25")?;
    let chunked = "4\r\nWiki\r\n5\r\npedia\r\nE\r\n in\r\n\r\nchunks.\r\n0\r\n\r\n";
    let decoded = decodeChunkedBody(chunked)?;
    assertTrue("decodeChunkedBody", decoded == "Wikipedia in\r\n\r\nchunks.")?;

    let hs = [HttpHeader("Content-Type", "application/json")];
    match httpHeaderGet(hs, "content-type") {
        Some(v) -> assertTrue("case-insensitive header lookup", v == "application/json")?,
        None -> assertTrue("header missing", false)?,
    };
    printLn("  [PASS] net.http: URL encoding, chunked decoding & header lookup");
    Ok(())
}

def testLiveHttps(): Result Void String = {
    let resp = httpsGet("example.com", "/")?;
    assertTrue("HTTPS example.com status == 200", resp.status == 200)?;
    assertTrue("HTTPS example.com body non-empty", strLen(resp.body) > 100)?;
    printLn("  [PASS] net.tls + net.http: live TLS 1.2/1.3 HTTPS GET example.com (CA+SNI verified, " + intToStr(strLen(resp.body)) + " bytes)");
    Ok(())
}

def main(): Void = {
    printLn("Running net.gsa test suite...");
    match testLoopbackWs() {
        Err(e) -> { eprintLn("FAIL: " + e); exit(1) },
        Ok(_) ->
            match testHttpHelpers() {
                Err(e) -> { eprintLn("FAIL: " + e); exit(1) },
                Ok(_) ->
                    match testLiveHttps() {
                        Err(e) -> { eprintLn("FAIL: " + e); exit(1) },
                        Ok(_) -> printLn("net.gsa: all tests passed!"),
                    },
            },
    }
}
