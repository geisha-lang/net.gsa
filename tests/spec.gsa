// Verification suite for `geisha-tls` (`tests/spec.gsa`).

use std.option.{Some, None}
use std.result.{Result, Ok, Err}
use std.str.intToStr
use sys.io.eprintLn
use sys.proc.exit

use tls.hmac.hmacSha256Hex
use tls.http.{HttpHeader, httpGet, httpHeaderGet, urlEncode, decodeChunkedBody}

def assertTrue(label: String, ok: Bool): Result Void String =
    if (ok) Ok(()) else Err("ASSERT FAILED: " + label)

def testHmacRfc4231(): Result Void String = {
    // RFC 4231 Test Case 2: Key = "Jefe", Data = "what do ya want for nothing?"
    let got1 = hmacSha256Hex("Jefe", "what do ya want for nothing?");
    assertTrue(
        "RFC 4231 TC2",
        got1 == "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843"
    )?;

    // Binance official API doc HMAC-SHA256 example:
    let secret = "NhqPtmdSJYdKjVHjA7PZj4Mge3R5YNiP1e3UZjInClVN65XAbvqqM6A7H5fATj0j";
    let query = "symbol=LTCBTC&side=BUY&type=LIMIT&timeInForce=GTC&quantity=1&price=0.1&recvWindow=5000&timestamp=1499827319559";
    let got2 = hmacSha256Hex(secret, query);
    assertTrue(
        "Binance API HMAC-SHA256 vector",
        got2 == "c8db56825ae71d6d79447849e617115f4a920fa2acdcab2b053c4b2838bd6b71"
    )?;

    printLn("  [PASS] tls.hmac: RFC 4231 + Binance API HMAC-SHA256 test vectors");
    Ok(())
}

def testHttpHelpers(): Result Void String = {
    assertTrue("urlEncode basic", urlEncode("BTC/USDT 100%") == "BTC%2FUSDT%20100%25")?;
    let chunked = "4\r\nWiki\r\n5\r\npedia\r\nE\r\n in\r\n\r\nchunks.\r\n0\r\n\r\n";
    let decoded = decodeChunkedBody(chunked)?;
    assertTrue("decodeChunkedBody", decoded == "Wikipedia in\r\n\r\nchunks.")?;

    let hs = [HttpHeader("Content-Type", "application/json"), HttpHeader("X-Rate-Limit", "42")];
    match httpHeaderGet(hs, "content-type") {
        Some(v) -> assertTrue("case-insensitive header lookup", v == "application/json")?,
        None -> assertTrue("header missing", false)?,
    };
    printLn("  [PASS] tls.http: URL encoding, chunked decoding & header lookup");
    Ok(())
}

def testLiveHttps(): Result Void String = {
    let resp = httpGet("example.com", "/")?;
    assertTrue("HTTPS example.com status == 200 (got " + intToStr(resp.status) + ")", resp.status == 200)?;
    assertTrue("HTTPS example.com body non-empty", strLen(resp.body) > 100)?;
    printLn("  [PASS] tls.http: live TLS 1.2/1.3 HTTPS GET example.com (CA+SNI verified, " + intToStr(strLen(resp.body)) + " bytes)");
    Ok(())
}

def main(): Void = {
    printLn("Running geisha-tls test suite...");
    match testHmacRfc4231() {
        Err(e) -> { eprintLn("FAIL: " + e); exit(1) },
        Ok(_) ->
            match testHttpHelpers() {
                Err(e) -> { eprintLn("FAIL: " + e); exit(1) },
                Ok(_) ->
                    match testLiveHttps() {
                        Err(e) -> { eprintLn("FAIL: " + e); exit(1) },
                        Ok(_) -> printLn("geisha-tls: all tests passed!"),
                    },
            },
    }
}
