// Pure-Geisha RFC 2104 HMAC-SHA256 (`tls.hmac`) built on `std.sha256`.
// Useful for exchange REST/WS API request signing (Binance, Deribit, etc.).

use std.sha256.{sha256New, sha256Update, sha256UpdateByte, sha256FinishHex}

def hexVal(b: Int): Int =
    if (b >= 48 && b <= 57) b - 48
    else if (b >= 97 && b <= 102) b - 87
    else if (b >= 65 && b <= 70) b - 55
    else 0

def hexToBytes32(hex: String): MutArray Int = {
    let out = arrayNew(32, 0);
    let i = cellNew(0);
    while (cellGet(i) < 32) {
        let idx = cellGet(i);
        let hi = hexVal(strByteAt(hex, idx * 2));
        let lo = hexVal(strByteAt(hex, idx * 2 + 1));
        arraySet(out, idx, (hi << 4) | lo);
        cellSet(i, idx + 1)
    };
    out
}

pub def hmacSha256Hex(key: String, msg: String): String = {
    let kBlock = arrayNew(64, 0);
    let kLen = strLen(key);
    if (kLen > 64) {
        let hCtx = sha256New();
        sha256Update(hCtx, key);
        let digest = hexToBytes32(sha256FinishHex(hCtx));
        let i = cellNew(0);
        while (cellGet(i) < 32) {
            let idx = cellGet(i);
            arraySet(kBlock, idx, arrayGet(digest, idx));
            cellSet(i, idx + 1)
        }
    } else {
        let i = cellNew(0);
        while (cellGet(i) < kLen) {
            let idx = cellGet(i);
            arraySet(kBlock, idx, strByteAt(key, idx) & 255);
            cellSet(i, idx + 1)
        }
    };

    // Inner hash: SHA256((K ^ ipad) || msg)
    let inner = sha256New();
    let i1 = cellNew(0);
    while (cellGet(i1) < 64) {
        let idx = cellGet(i1);
        sha256UpdateByte(inner, (arrayGet(kBlock, idx) ^ 54) & 255);
        cellSet(i1, idx + 1)
    };
    sha256Update(inner, msg);
    let innerBytes = hexToBytes32(sha256FinishHex(inner));

    // Outer hash: SHA256((K ^ opad) || inner)
    let outer = sha256New();
    let i2 = cellNew(0);
    while (cellGet(i2) < 64) {
        let idx = cellGet(i2);
        sha256UpdateByte(outer, (arrayGet(kBlock, idx) ^ 92) & 255);
        cellSet(i2, idx + 1)
    };
    let i3 = cellNew(0);
    while (cellGet(i3) < 32) {
        let idx = cellGet(i3);
        sha256UpdateByte(outer, arrayGet(innerBytes, idx));
        cellSet(i3, idx + 1)
    };
    sha256FinishHex(outer)
}
