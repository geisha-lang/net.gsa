// WebSocket over TLS (`net.wss`) — thin wrapper over `net.tls` + generic `net.ws`.
// Returned `WsConn TlsStream` uses the exact same `wsRecv`, `wsSendTextMasked`,
// `wsSendPong`, and `wsClose` from `net.ws`.

use std.result.Result
use std.buf.{bufNew, bufPushStr, bufToString}
use net.tls.{TlsStream, tlsConnectWithTimeout}
use net.ws.{WsConn, wsUpgradeClient}
use net.http.HttpHeader

def formatExtraHeaders(headers: List HttpHeader): String = {
    let out = bufNew();
    formatExtraRec(out, headers);
    bufToString(out)
}

def formatExtraRec(out: std.buf.StringBuf, headers: List HttpHeader): Void = match headers {
    Nil -> (),
    Cons(HttpHeader(k, v), rest) -> {
        bufPushStr(out, k);
        bufPushStr(out, ": ");
        bufPushStr(out, v);
        bufPushStr(out, "\r\n");
        formatExtraRec(out, rest)
    },
}

pub def wssConnect(host: String, port: Int, path: String): Result (WsConn TlsStream) String =
    wssConnectWithHeaders(host, port, path, Nil, 15000)

pub def wssConnectWithHeaders(
    host: String,
    port: Int,
    path: String,
    extraHeaders: List HttpHeader,
    timeoutMs: Int
): Result (WsConn TlsStream) String = {
    let stream = tlsConnectWithTimeout(host, port, timeoutMs)?;
    wsUpgradeClient(stream, host, path, formatExtraHeaders(extraHeaders))
}
